# Copy this file to ".env" and fill in your real values.
# The .env file is read by load.py and (later) by app.py.
# DO NOT commit .env to GitHub.

# From Supabase: Project Settings > API > Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# From Supabase: Project Settings > API > Project API keys > "service_role"
# WARNING: this key bypasses Row Level Security. Treat it like a password.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# From Supabase: Project Settings > Database > Connection string > URI
# Used later by the Streamlit app for read-only SQL queries.
SUPABASE_DB_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# From console.anthropic.com > API keys
ANTHROPIC_API_KEY=sk-ant-...

# Shared password to access the deployed app. Pick anything memorable.
# Leave blank locally to skip the gate during development.
APP_PASSWORD=
